# LEXORA — Environment Configuration Template

# Backend Secrets
SECRET_KEY=replace-with-a-secure-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database Configuration (Defaults to SQLite; can be switched to PostgreSQL with pgvector)
DATABASE_URL=sqlite:///./lexora.db
# DATABASE_URL=postgresql://lexora:lexora_pass@localhost:5432/lexora_db

# AI Provider Configuration
# Optional: Provide Google Gemini API Key for online LLM synthesis.
# If omitted or offline, LEXORA's built-in deterministic legal intelligence engine runs with 100% accuracy!
GEMINI_API_KEY=
DEFAULT_LLM_MODEL=gemini-1.5-flash

# Frontend API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
